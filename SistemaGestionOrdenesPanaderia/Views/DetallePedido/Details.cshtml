@model SistemaGestionOrdenesPanaderia.Models.DetallePedido

<h1>Detalles del Pedido</h1>

<div>
    <h4>Detalle de Pedido</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">Pedido</dt>
        <dd class="col-sm-10">@Model.PedidoId</dd>

        <dt class="col-sm-2">Producto</dt>
        <dd class="col-sm-10">@Model.ProductoId</dd>

        <dt class="col-sm-2">Cantidad</dt>
        <dd class="col-sm-10">@Model.Cantidad</dd>

        <dt class="col-sm-2">Precio</dt>
        <dd class="col-sm-10">@Model.Precio</dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</div>