@model SistemaGestionOrdenesPanaderia.Models.DetallePedido

<h1>Nuevo Detalle de Pedido</h1>

<form asp-action="Create" method="post">

    <div class="form-group">
        <label asp-for="PedidoId">Pedido</label>
        <select asp-for="PedidoId" class="form-control" asp-items="ViewBag.PedidoId">
            <option value="">Seleccione un pedido</option>
        </select>
    </div>

    <div class="form-group">
        <label asp-for="ProductoId">Producto</label>
        <select asp-for="ProductoId" class="form-control" asp-items="ViewBag.ProductoId">
            <option value="">Seleccione un producto</option>
        </select>
    </div>

    <div class="form-group">
        <label asp-for="Cantidad">Cantidad</label>
        <input asp-for="Cantidad" class="form-control" type="number" min="1" />
    </div>

    <div class="form-group">
        <label asp-for="Precio">Precio</label>
        <input asp-for="Precio" class="form-control" type="number" step="0.01" />
    </div>

    <br />

    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>

</form>