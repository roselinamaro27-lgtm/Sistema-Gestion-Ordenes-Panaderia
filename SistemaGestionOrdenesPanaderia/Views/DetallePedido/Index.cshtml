@model IEnumerable<SistemaGestionOrdenesPanaderia.Models.DetallePedido>

<h1>Detalles de Pedidos</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Nuevo Detalle</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Pedido</th>
            <th>Producto</th>
            <th>Cantidad</th>
            <th>Precio</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var detalle in Model)
        {
            <tr>
                <td>@detalle.PedidoId</td>
                <td>@detalle.ProductoId</td>
                <td>@detalle.Cantidad</td>
                <td>@detalle.Precio</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@detalle.Id">Editar</a> |
                    <a asp-action="Details" asp-route-id="@detalle.Id">Detalles</a> |
                    <a asp-action="Delete" asp-route-id="@detalle.Id">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>