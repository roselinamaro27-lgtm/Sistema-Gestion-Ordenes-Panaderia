@{
    ViewData["Title"] = "Sistema de Gestión de Órdenes";
}

<div class="text-center">
    <h1 class="display-4">Sistema de Gestión de Órdenes</h1>
    <p>Panadería</p>
</div>

<div class="row mt-4">
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h4>Productos</h4>
                <p>Gestionar los productos de la panadería.</p>
                <a asp-controller="Producto" asp-action="Index" class="btn btn-primary">Ver Productos</a>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h4>Clientes</h4>
                <p>Gestionar los clientes.</p>
                <a asp-controller="Cliente" asp-action="Index" class="btn btn-primary">Ver Clientes</a>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h4>Pedidos</h4>
                <p>Gestionar los pedidos.</p>
                <a asp-controller="Pedido" asp-action="Index" class="btn btn-primary">Ver Pedidos</a>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h4>Detalles de pedidos</h4>
                <p>Gestionar los detalles de los pedidos.</p>
                <a asp-controller="DetallePedido" asp-action="Index" class="btn btn-primary">Ver Detalles</a>
            </div>
        </div>
    </div>
</div>